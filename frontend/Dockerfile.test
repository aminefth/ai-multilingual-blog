FROM node:18-alpine

WORKDIR /app

# Copy package.json and package-lock.json
COPY package*.json ./

# Install dependencies including development dependencies
RUN npm install --include=dev

# Copy source files
COPY . .

# Build the frontend (if needed)
# RUN npm run build

# Expose the port for the frontend test server
EXPOSE 3000

# Command to start the frontend in test mode
CMD ["npm", "run", "dev"]
