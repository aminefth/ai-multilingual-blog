# Application Configuration
NODE_ENV=development
PORT=3001
API_VERSION=v1
FRONTEND_URL=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/ai-tools-blog
REDIS_URL=redis://localhost:6379

# Authentication and JWT
JWT_SECRET=your-super-secret-jwt-key
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=support@ai-tools-blog.com

# AI Services
OPENAI_API_KEY=your-openai-api-key
DEEPL_API_KEY=your-deepl-translation-key

# Payment Processing
STRIPE_SECRET_KEY=sk_test_your-stripe-test-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
PRICING_BASIC_PLAN_ID=price_basic_monthly
PRICING_PRO_PLAN_ID=price_pro_monthly
PRICING_ENTERPRISE_PLAN_ID=price_enterprise_monthly

# Storage & CDN
CLOUDFLARE_R2_ENDPOINT=your-r2-endpoint
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-key
CLOUDFLARE_R2_BUCKET=ai-tools-blog-storage

# Logging & Monitoring
LOG_LEVEL=debug
SENTRY_DSN=your-sentry-dsn
